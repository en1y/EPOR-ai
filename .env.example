# Optional local-only control-plane overrides. Never commit real credentials.
EPOR_PROJECT_ROOT=.
EPOR_CONTROL_HOST=127.0.0.1
EPOR_CONTROL_PORT=8742
EPOR_CONTROL_UI_ORIGIN=http://127.0.0.1:5173
EPOR_CONTROL_DATABASE=.epor/control.sqlite3
EPOR_CONTROL_ARTIFACT_ROOT=.epor/artifacts
EPOR_RESEARCH_CATALOG=research/catalog.yaml
EPOR_CONTROL_STALE_AFTER_SECONDS=120
EPOR_CONTROL_POLL_INTERVAL_SECONDS=0.5
